# 旧サイト（ファイズ制作版）からの301
# 旧URLごとに内容が最も近い新ページへ1対1で転送する。
/index.php / 301
/index.html / 301
/about.php /about.html 301
/selection.php /adult-shoes.html 301
/childrenshoes.php /childrens-shoes.html 301
/product.php /products.html 301
/insole.php /insoles.html 301
/seminar.php /seminars.html 301
/contact.php /contact.html 301
/dimoco-insole.html /dymoco-insole.html 301

# 配信しないファイル
# Cloudflare Pages の Build output directory が "." のため、
# リポジトリ直下のファイルはそのまま公開される。サイトの一部でない
# ファイルはここで塞ぐ。リダイレクトは静的アセットより優先されるため、
# 実ファイルが存在していても配信されない。
# 新しい資料は必ず docs/ に置くこと（下の1行で自動的に塞がれる）。
/docs/* / 301
/scripts/* / 301
/package.json / 301
/README.md / 301
/.env.example / 301
/.gitignore / 301
