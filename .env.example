# お知らせ欄（microCMS）のローカル確認用。実際の値は Cloudflare Pages の
# Settings > Environment variables (Production / Preview 両方) に設定してください。
# .env は .gitignore 済みで、コミットしないでください。
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# お役立ち記事CMS（管理画面・記事一覧・オンライン相談・PDF商品）用のSupabase設定。
# docs/supabase/schema.sql をSupabaseプロジェクトのSQL Editorで実行してから設定する。
# anon key は公開されても問題ない設計のキー（アクセス制御はRLSで行う）。
# `npm run cms:config` を実行すると assets/supabase-config.js に書き出され、
# 管理画面・公開ページ・script.js の計測コードから読み込まれる。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 管理画面の「AIで下書きを作る」機能（省略可）。
# Cloudflare Pages Functions (functions/api/generate.js) の環境変数として、
# Cloudflare Pagesダッシュボードの Settings > Environment variables に設定する
# （.envではなくCloudflare側の設定。ここには値の形を示すために記載）。
# 未設定の場合、管理画面は自動的に媒体別テンプレート表示に切り替わる。
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-haiku-4-5
